# KMD Check environment template
# Copy to .env.local for local development. Never commit real credentials.

# Google Apps Script Web App URL
VITE_GAS_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Optional client-side Telegram fallback.
# Recommended: keep notification credentials server-side in Google Apps Script / Script Properties.
VITE_TELEGRAM_BOT_TOKEN=""
VITE_TELEGRAM_CHAT_ID=""

# Optional WuzAPI development values.
# Recommended: configure these only on the backend, never in a VITE_* variable for production.
VITE_WUZAPI_TOKEN=""
VITE_WUZAPI_SENDER_JID=""
VITE_WUZAPI_API_URL=""
VITE_WUZAPI_GROUP_ID=""

# Optional application URL
APP_URL=""

# Optional Gemini key. Do not expose a privileged production key through client-side VITE_* variables.
GEMINI_API_KEY=""
